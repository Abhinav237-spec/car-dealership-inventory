# Copy to .env and adjust. These defaults match docker-compose.yml.
PORT=3000
DATABASE_URL=postgres://dealership:dealership@localhost:5432/dealership
# Integration tests run only when this is set:
TEST_DATABASE_URL=postgres://dealership:dealership@localhost:5432/dealership_test

# Use a long random value in any real deployment.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN_SECONDS=3600
BCRYPT_COST=10

# Used by `npm run seed` (development credentials only).
ADMIN_EMAIL=admin@dealership.test
ADMIN_PASSWORD=Admin#12345
